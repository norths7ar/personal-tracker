# OpenAI-compatible LLM API key
LLM_API_KEY=your_llm_api_key_here

# App access control. Local development usually keeps this disabled.
AUTH_ENABLED=false
APP_PASSWORD=
APP_SESSION_SECRET=
COOKIE_SECURE=false

# Optional SQLite file path. Relative paths are resolved from the project root.
DATABASE_PATH=data/expenses.db
